

@page "/bouquets"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using View.Services
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components

@inject HttpClient Http
@inject ShoppingCartService CartState
@inject NavigationManager Navigation

<PageTitle>חנות הזרים | Roni Rose</PageTitle>

<div class="w-full text-right">

    <!-- כותרת החנות -->
    <section class="text-center py-10 sm:py-16">
        <p class="text-secondary tracking-[0.3em] text-xs font-semibold mb-4">
            RONI ROSE COLLECTION
        </p>

        <h1 class="font-headline-lg text-4xl sm:text-5xl text-on-surface mb-5">
            קולקציית הזרים שלנו
        </h1>

        <p class="text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
            כל זר נבחר ונשזר בקפידה, עם תשומת לב לכל פרח ולכל פרט קטן.
            מצאו את הזר המושלם עבורכם.
        </p>

        <div class="w-20 h-[2px] bg-primary mx-auto mt-8"></div>
    </section>

    <!-- כותרת מוצרים -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8 border-b border-[#e8ded4] pb-5">

        <div>
            <h2 class="font-headline-md text-2xl text-on-surface">
                @if (!string.IsNullOrWhiteSpace(SearchTerm))
                {
                    <span>תוצאות חיפוש</span>
                }
                else
                {
                    <span>כל הזרים</span>
                }
            </h2>

            @if (!isLoading && !hasError)
            {
                <p class="text-sm text-on-surface-variant mt-1">
                    נמצאו @FilteredProducts.Count() מוצרים
                </p>
            }
        </div>

        <button @onclick="GoToCart"
                class="flex items-center gap-2 bg-primary text-white px-5 py-3 rounded-full hover:bg-primary-container transition-all">

            <span class="material-symbols-outlined text-[20px]">
                shopping_bag
            </span>

            <span>
                לסל הקניות (@CartState.TotalQuantity())
            </span>

        </button>

    </div>

    @if (!string.IsNullOrWhiteSpace(SearchTerm))
    {
        <div class="flex items-center justify-between bg-[#fff8f3] border border-[#eee2d6] rounded-xl px-4 py-3 mb-6">
            <p class="text-sm text-on-surface">
                תוצאות עבור: <strong>@SearchTerm</strong>
            </p>

            <button @onclick="ClearSearch"
                    class="text-sm text-primary hover:underline">
                נקה חיפוש
            </button>
        </div>
    }

    <!-- תוכן החנות -->
    @if (isLoading)
    {
        <div class="py-24 text-center">
            <span class="material-symbols-outlined text-4xl text-primary animate-pulse">
                local_florist
            </span>

            <p class="text-on-surface-variant mt-4">
                טוענים את קולקציית הזרים...
            </p>
        </div>
    }
    else if (hasError)
    {
        <div class="bg-red-50 border border-red-200 rounded-2xl p-8 text-center">
            <span class="material-symbols-outlined text-4xl text-red-500">
                error
            </span>

            <h3 class="font-headline-md text-xl mt-3 text-on-surface">
                לא הצלחנו לטעון את המוצרים
            </h3>

            <p class="text-on-surface-variant mt-2">
                @errorMessage
            </p>

            <button @onclick="LoadProducts"
                    class="mt-5 bg-primary text-white px-6 py-3 rounded-full hover:bg-primary-container transition-colors">
                נסו שוב
            </button>
        </div>
    }
    else if (!FilteredProducts.Any())
    {
        <div class="py-20 text-center">
            <span class="material-symbols-outlined text-5xl text-secondary">
                search_off
            </span>

            <h3 class="font-headline-md text-2xl mt-4">
                לא נמצאו מוצרים
            </h3>

            <p class="text-on-surface-variant mt-2">
                לא מצאנו מוצרים שמתאימים לחיפוש שלך.
                אפשר לנסות מילה אחרת.
            </p>

            <button @onclick="ClearSearch"
                    class="mt-5 bg-primary text-white px-6 py-3 rounded-full hover:bg-primary-container transition-colors">
                הצגת כל המוצרים
            </button>
        </div>
    }
    else
    {
        <!-- רשימת מוצרים -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">

            @foreach (var product in FilteredProducts)
            {
                <div @key="product.ProductID"
                     class="group bg-[#fdfbf9] rounded-2xl overflow-hidden border border-[#eee5dc] shadow-[0_5px_20px_rgba(74,66,56,0.05)] hover:shadow-[0_12px_30px_rgba(74,66,56,0.12)] transition-all duration-300">

                    <!-- תמונת מוצר -->
                    <div class="relative h-72 overflow-hidden bg-[#f4ece4]">

                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.ProductName"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else if (product.ProductImageBlob != null &&
                                 product.ProductImageBlob.Length > 0)
                        {
                            <img src="@GetBlobImage(product.ProductImageBlob)"
                                 alt="@product.ProductName"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full flex flex-col items-center justify-center text-secondary">
                                <span class="material-symbols-outlined text-6xl">
                                    local_florist
                                </span>

                                <span class="text-sm mt-2">
                                    תמונה לא זמינה
                                </span>
                            </div>
                        }

                        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm rounded-full px-4 py-2 text-xs text-primary font-semibold">
                            RONI ROSE
                        </div>
                    </div>

                    <!-- פרטי מוצר -->
                    <div class="p-6">

                        <h3 class="font-headline-md text-xl text-on-surface mb-3">
                            @product.ProductName
                        </h3>

                        @if (!string.IsNullOrWhiteSpace(product.Description))
                        {
                            <p class="text-sm text-on-surface-variant leading-relaxed min-h-12 mb-5">
                                @product.Description
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-on-surface-variant min-h-12 mb-5">
                                זר פרחים מעוצב מבית Roni Rose.
                            </p>
                        }

                        <div class="flex items-center justify-between border-t border-[#eee5dc] pt-5">

                            <div>
                                <span class="text-xs text-on-surface-variant block mb-1">
                                    מחיר
                                </span>

                                <span class="font-headline-md text-xl text-primary font-semibold">
                                    ₪@product.Price.ToString("N2")
                                </span>
                            </div>

                            <button @onclick="() => AddToCart(product)"
                                    class="flex items-center gap-2 bg-primary text-white px-4 py-3 rounded-full hover:bg-primary-container active:scale-95 transition-all">

                                <span class="material-symbols-outlined text-[19px]">
                                    add_shopping_cart
                                </span>

                                <span class="text-sm">
                                    הוסף לסל
                                </span>

                            </button>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <!-- הודעת הוספה לסל -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="fixed bottom-6 right-6 z-[60] bg-[#251f1c] text-white px-6 py-4 rounded-xl shadow-xl flex items-center gap-3">

            <span class="material-symbols-outlined text-emerald-400">
                check_circle
            </span>

            <span>@successMessage</span>

        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string? SearchTerm { get; set; }

    private List<CartProduct> products = new List<CartProduct>();

    private bool isLoading = true;
    private bool hasError = false;

    private string errorMessage = "";
    private string successMessage = "";

    // מוצרים לאחר סינון לפי החיפוש
    private IEnumerable<CartProduct> FilteredProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
            {
                return products;
            }

            string search = SearchTerm.Trim();

            return products.Where(product =>
                (!string.IsNullOrWhiteSpace(product.ProductName) &&
                 product.ProductName.Contains(search, StringComparison.OrdinalIgnoreCase)) ||

                (!string.IsNullOrWhiteSpace(product.Description) &&
                 product.Description.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";

        try
        {
            List<CartProduct>? result =
                await Http.GetFromJsonAsync<List<CartProduct>>("api/products");

            products = result ?? new List<CartProduct>();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = "לא ניתן להתחבר לשרת המוצרים. " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddToCart(CartProduct product)
    {
        CartState.AddProduct(product);

        successMessage = product.ProductName + " נוסף לסל הקניות";

        StateHasChanged();
    }

    private void GoToCart()
    {
        Navigation.NavigateTo("/cart");
    }

    private void ClearSearch()
    {
        Navigation.NavigateTo("/bouquets");
    }

    private string GetBlobImage(byte[] image)
    {
        return "data:image/jpeg;base64," + Convert.ToBase64String(image);
    }
}

