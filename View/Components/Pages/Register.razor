@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Model
@using View.Components.Shared

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>הרשמה לבוטיק · Roni Rose</PageTitle>

<div class="flex flex-col items-center justify-center py-10 px-4">
    <div class="w-full max-w-md">

        <div class="bg-surface-container-lowest border border-[#eee2d6] shadow-[0_12px_36px_rgba(74,66,56,0.08)] rounded-3xl p-8 sm:p-10 text-right">

            <h1 class="font-headline-md text-2xl sm:text-3xl text-on-surface font-normal mb-2">
                יצירת חשבון חדש
            </h1>

            <p class="text-on-surface-variant text-sm mb-6">
                הצטרפו למועדון הלקוחות של Roni Rose למעקב נוח אחר משלוחים והטבות בלעדיות.
            </p>

            <form novalidate class="space-y-4">

                <Field Id="reg-fullname"
                       Label="שם מלא"
                       Name="fullName"
                       Value="@fullName"
                       ValueChanged="UpdateFullName" />

                <Field Id="reg-username"
                       Label="שם משתמש"
                       Name="username"
                       Value="@username"
                       ValueChanged="UpdateUsername" />

                <Field Id="reg-email"
                       Label="כתובת אימייל"
                       Name="email"
                       Type="email"
                       Dir="ltr"
                       Value="@email"
                       ValueChanged="UpdateEmail" />

                <Field Id="reg-phone"
                       Label="מספר טלפון"
                       Name="phone"
                       Type="tel"
                       Dir="ltr"
                       Value="@phone"
                       ValueChanged="UpdatePhone" />

                <Field Id="reg-password"
                       Label="סיסמה"
                       Name="password"
                       Type="password"
                       Dir="ltr"
                       Value="@password"
                       ValueChanged="UpdatePassword" />

                <Field Id="reg-confirm"
                       Label="אימות סיסמה"
                       Name="confirmPassword"
                       Type="password"
                       Dir="ltr"
                       Value="@confirmPassword"
                       ValueChanged="UpdateConfirmPassword" />

                @if (errorMessage != null)
                {
                    <div class="p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm mt-2"
                         role="alert">
                        @errorMessage
                    </div>
                }

                @if (isRegistered)
                {
                    <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm mt-2"
                         role="status">
                        <strong>ההרשמה בוצעה בהצלחה!</strong>
                        עוברים לדף הכניסה בעוד @secondsLeft שניות.
                    </div>
                }

                <button style="background-color: #8a4a3d !important; border-color: #8a4a3d !important; color: #ffffff !important;"
                        class="w-full mt-4 py-3 px-4 rounded-xl font-label-lg text-sm sm:text-base transition-all shadow-md active:scale-95 disabled:opacity-50 cursor-pointer border-0"
                        type="button"
                        disabled="@(isBusy || isRegistered)"
                        @onclick="RegisterAsync">

                    @(isBusy ? "יוצר חשבון..." : "הירשמו עכשיו")

                </button>

            </form>
        </div>

        <p class="text-center mt-6 text-on-surface-variant text-sm">
            כבר רשומים אצלנו?
            <a class="font-semibold text-primary hover:underline" href="login">
                לכניסה לחשבון
            </a>
        </p>

    </div>
</div>

@code {

    private string? fullName;
    private string? username;
    private string? email;
    private string? phone;
    private string? password;
    private string? confirmPassword;

    private string? errorMessage;

    private bool isBusy;
    private bool isRegistered;

    private int secondsLeft = 5;

    private void UpdateFullName(string? val)
    {
        fullName = val;
    }

    private void UpdateUsername(string? val)
    {
        username = val;
    }

    private void UpdateEmail(string? val)
    {
        email = val;
    }

    private void UpdatePhone(string? val)
    {
        phone = val;
    }

    private void UpdatePassword(string? val)
    {
        password = val;
    }

    private void UpdateConfirmPassword(string? val)
    {
        confirmPassword = val;
    }

    private async Task RegisterAsync()
    {
        errorMessage = null;

        fullName = fullName?.Trim();
        username = username?.Trim();
        email = email?.Trim();
        phone = phone?.Trim();

        if (string.IsNullOrWhiteSpace(fullName) ||
            string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(phone) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        // בדיקת תקינות שם המשתמש
        string error = UserValidator.ValidateUsername(username);

        // בדיקת תקינות האימייל
        if (error == "")
        {
            error = UserValidator.ValidateEmail(email);
        }

        // בדיקת תקינות הסיסמה
        if (error == "")
        {
            error = UserValidator.ValidatePassword(password);
        }

        // אם נמצאה שגיאה, מציגים אותה ולא ממשיכים
        if (error != "")
        {
            errorMessage = error;
            return;
        }

        // בדיקת התאמת הסיסמאות
        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה אינם תואמים.";
            return;
        }

        isBusy = true;

        try
        {
            bool usernameExists =
                await Http.GetFromJsonAsync<bool>(
                    $"api/users/exists/{Uri.EscapeDataString(username)}");

            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס במערכת. בחרו שם אחר.";
                return;
            }

            bool emailExists =
                await Http.GetFromJsonAsync<bool>(
                    $"api/users/email-exists/{Uri.EscapeDataString(email)}");

            if (emailExists)
            {
                errorMessage = "כתובת האימייל כבר רשומה במערכת.";
                return;
            }

            User newUser = new User();

            newUser.Username = username;
            newUser.Email = email;
            newUser.Password = password;
            newUser.FullName = fullName;
            newUser.Phone = phone;

            HttpResponseMessage response =
                await Http.PostAsJsonAsync("api/users", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת אינו זמין כרגע. נסו שוב בעוד רגע.";
            return;
        }
        finally
        {
            isBusy = false;
        }

        isRegistered = true;

        while (secondsLeft > 0)
        {
            StateHasChanged();

            await Task.Delay(1000);

            secondsLeft--;
        }

        Navigation.NavigateTo("login");
    }
}
