
@API_HostAddress = http://localhost:5010

GET {{API_HostAddress}}/weatherforecast/
Accept: application/json

###
# ===== Users =====

# כל המשתמשים
GET {{API_HostAddress}}/api/users
Accept: application/json

###

# משתמש לפי מזהה
GET {{API_HostAddress}}/api/users/1
Accept: application/json

###

# האם שם משתמש קיים (צפוי: true)
GET {{API_HostAddress}}/api/users/exists/admin

###

# האם שם משתמש קיים (צפוי: true)
GET {{API_HostAddress}}/api/users/exists/dana.cohen

###

# האם אימייל קיים (צפוי: true)
GET {{API_HostAddress}}/api/users/email-exists/admin@example.com

###

# ספירת משתמשים לפי תפקיד
GET {{API_HostAddress}}/api/users/count-by-role

###

# הוספת משתמש בדיקה (תפקיד ברירת מחדל: Customer)
POST {{API_HostAddress}}/api/users
Content-Type: application/json

{
  "username": "test_user",
  "email": "test.user@example.com",
  "password": "Test1234"
}

###

# הרשמה עם נתונים לא תקינים - בדיקת UserValidator
# צפוי: 400 Bad Request ושלוש הודעות שגיאה
POST {{API_HostAddress}}/api/users
Content-Type: application/json

{
  "username": "a",
  "email": "not-an-email",
  "password": "123"
}

###

# התחברות עם פרטים נכונים (צפוי: 200 והמשתמש)
POST {{API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "barnealior",
  "password": "1234"
}

###
